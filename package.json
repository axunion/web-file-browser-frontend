{
  "name": "web-file-browser-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check . && tsc -b",
    "fix": "biome check --write .",
    "generate:icons": "node scripts/generateIconBundle.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@iconify/react": "^6.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
